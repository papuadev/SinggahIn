datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  TENANT
}

enum TokenType {
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
}

enum BookingStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  PROCESSED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  PAYMENT_GATEWAY
}

enum PaymentStatus {
  PENDING
  WAITING_APPROVAL
  SETTLEMENT
  REJECTED
  EXPIRED
  CANCELLED
}

enum AdjustmentType {
  NOMINAL
  PERCENTAGE
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  passwordHash   String?
  name           String?
  role           Role                @default(USER)
  isVerified     Boolean             @default(false)
  avatarUrl      String?
  avatarPublicId String?
  phoneNumber    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tokens         VerificationToken[]
  properties     Property[]          @relation("TenantProperties")
  bookings       Booking[]           @relation("UserBookings")
  reviews        Review[]            @relation("UserReviews")

  @@map("users")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token, type, isUsed])
  @@map("verification_tokens")
}

model PropertyCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  properties  Property[]

  @@map("property_categories")
}

model Property {
  id          String           @id @default(cuid())
  tenantId    String
  categoryId  String
  title       String
  description String           @db.Text
  address     String
  city        String
  latitude    Float
  longitude   Float
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      User             @relation("TenantProperties", fields: [tenantId], references: [id], onDelete: Cascade)
  category    PropertyCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      PropertyImage[]
  rooms       Room[]
  bookings    Booking[]
  reviews     Review[]

  @@index([city, categoryId])
  @@index([tenantId])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  imageUrl   String
  publicId   String
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Room {
  id               String               @id @default(cuid())
  propertyId       String
  name             String
  basePrice        Int
  capacity         Int
  totalUnits       Int                  @default(1)
  description      String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  property         Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  modifiers        RoomPriceModifier[]
  unavailabilities RoomUnavailability[]
  bookings         Booking[]

  @@index([propertyId])
  @@map("rooms")
}

model RoomPriceModifier {
  id              String         @id @default(cuid())
  roomId          String
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  adjustmentType  AdjustmentType
  adjustmentValue Int
  reason          String?
  createdAt       DateTime       @default(now())

  room            Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
  @@map("room_price_modifiers")
}

model RoomUnavailability {
  id        String   @id @default(cuid())
  roomId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
  @@map("room_unavailabilities")
}

model Booking {
  id                 String        @id @default(cuid())
  bookingCode        String        @unique
  userId             String
  propertyId         String
  roomId             String
  checkInDate        DateTime      @db.Date
  checkOutDate       DateTime      @db.Date
  totalNights        Int
  guestCount         Int
  totalPrice         Int
  status             BookingStatus @default(WAITING_PAYMENT)
  cancellationReason String?
  refundContact      String?
  expiresAt          DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user               User          @relation("UserBookings", fields: [userId], references: [id], onDelete: Restrict)
  property           Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  room               Room          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payment            Payment?
  review             Review?

  @@index([checkInDate, checkOutDate, roomId, status])
  @@index([userId, status])
  @@index([propertyId, status])
  @@map("bookings")
}

model Payment {
  id                   String        @id @default(cuid())
  bookingId            String        @unique
  paymentMethod        PaymentMethod
  amount               Int
  status               PaymentStatus @default(PENDING)
  proofImageUrl        String?
  proofPublicId        String?
  gatewayOrderId       String?
  gatewayTransactionId String?
  paidAt               DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  userId     String
  propertyId String
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user       User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Restrict)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("reviews")
}
