NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/singgahin_db?schema=public"

# JWT Authentication
JWT_SECRET="singgahin-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"

# Cloudinary CDN (Media Storage)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# OpenCage Geocoding API
OPENCAGE_API_KEY="your_opencage_api_key"

# Midtrans Payment Gateway (Sandbox)
MIDTRANS_SERVER_KEY="SB-Mid-server-your_server_key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your_client_key"
MIDTRANS_IS_PRODUCTION=false

# Nodemailer SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="SinggahIn <no-reply@singgahin.com>"
