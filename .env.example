# ==========================================
# SinggahIn Production & Local Docker Environment
# ==========================================

# Network & Host
PORT=5000
CLIENT_URL=http://localhost
VITE_API_BASE_URL=/api/v1

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=singgahin_db
POSTGRES_PORT=5432

# JWT Secret & Expiry
JWT_SECRET=singgahin-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Cloudinary CDN (1MB Max Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenCage Geocoding API
OPENCAGE_API_KEY=your_opencage_api_key

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
MIDTRANS_IS_PRODUCTION=false

# Nodemailer / SMTP Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SinggahIn <no-reply@singgahin.com>"
